# 의존성 (npm install로 재생성됨)
node_modules/
**/node_modules/

# 절대 커밋 금지 — 앱 서명 키 (유출 시 앱 위변조 위험)
keystore/
*.jks
*.keystore

# 절대 커밋 금지 — 비밀값/환경변수
.env
.env.local
.env.*.local
*.env

# 네이티브 — 산출물은 제외하되, '손으로 고친 것'만 추적한다 (2026-08-30)
#   왜: android/ 를 통째로 빼두면 매니페스트 권한·앱이름·직접 만든 플러그인 자바가
#       저장소 어디에도 없어서, PC 가 잘못되면 복구할 방법이 없다.
#   ⚠️ 'android/' 처럼 폴더째 제외하면 git 이 그 안으로 들어가지 않아
#      아래 ! 예외가 전부 무효가 된다. 반드시 단계별로 열어야 한다.
android/*
!android/build.gradle
!android/variables.gradle
!android/app/
android/app/*
!android/app/build.gradle
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml
!android/app/src/main/java/
!android/app/src/main/res/
#   ⛔ 공개 저장소이므로 넣지 않는다
android/app/google-services.json
#   캡시터가 만들어 주는 것은 추적 불필요
android/app/src/main/java/com/getcapacitor/

ios/
*.apk
*.aab

# 백업/정리 대상 파일 (프로젝트 정리 중 생긴 임시 파일들)
_bak/
_bak_archive/
_to_delete/
*.bak
*.bak.*

# 빌드/캐시 산출물
.firebase/
.wrangler/
dist/
build/
.DS_Store
npm-debug.log*
*.log
