# 의존성 (npm install로 재생성됨)
node_modules/
**/node_modules/

# 절대 커밋 금지 — 앱 서명 키 (유출 시 앱 위변조 위험)
keystore/
*.jks
*.keystore

# 절대 커밋 금지 — 비밀값/환경변수
.env
.env.local
.env.*.local
*.env

# 네이티브 — 캡시터가 android/.gitignore 로 산출물을 이미 걸러준다 (2026-08-30)
#   build/ · .gradle/ · local.properties · capacitor-cordova-android-plugins ·
#   app/src/main/assets/public(www 사본) · 생성 config · *.apk/*.aab 전부 거기서 제외됨.
#   그래서 여기서는 '비밀'만 추가로 막고, 나머지 android 프로젝트는 그대로 추적한다.
#   (이렇게 해야 GitHub Actions 가 저장소만 받아서 APK 를 빌드할 수 있다)
#   google-services.json 은 '비밀'이 아니다 — APK 안에 그대로 들어가는 공개 식별자 묶음이고
#   실제 방어선은 Firestore/Storage 규칙이다. 빼두면 CI 빌드가 깨져서 넣기로 했다.
#   진짜 비밀(keystore/.env)은 위에서 이미 막고 있다.
android/.idea/

ios/
*.apk
*.aab

# 백업/정리 대상 파일 (프로젝트 정리 중 생긴 임시 파일들)
_bak/
_bak_archive/
_to_delete/
*.bak
*.bak.*

# 빌드/캐시 산출물
.firebase/
.wrangler/
dist/
build/
.DS_Store
npm-debug.log*
*.log
