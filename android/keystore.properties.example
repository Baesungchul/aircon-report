# 이 파일을 복사해서 android/keystore.properties 로 만들고 실제 값을 채우세요.
# keystore.properties(실제 파일)는 .gitignore 로 막혀 있어 깃에 절대 올라가지 않습니다.
#
# storeFile: 정식 서명키(.jks) 파일의 경로.
#   - android 폴더 기준 상대경로 또는 절대경로 둘 다 가능
#   - 윈도우 경로면 역슬래시(\) 대신 슬래시(/)를 쓰거나 \\ 로 이스케이프 하세요
#     예) C:/Users/bsc32/keys/aircon-release.jks
storeFile=C:/path/to/your-release-key.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=여기에_key_alias
keyPassword=여기에_key_비밀번호
